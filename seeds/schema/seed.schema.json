{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeedApplication",
  "description": "Schema for platform seed application specifications",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "platform.local.dev/v1"
    },
    "kind": {
      "type": "string",
      "const": "SeedApplication"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
          "maxLength": 63,
          "description": "Application name (lowercase, hyphens only)"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["name", "team", "language", "description", "repository", "infrastructure", "resources"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
          "maxLength": 63
        },
        "team": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
          "maxLength": 63
        },
        "language": {
          "type": "string",
          "enum": ["python", "go", "nodejs", "java", "rust"]
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "repository": {
          "type": "object",
          "required": ["organization"],
          "additionalProperties": false,
          "properties": {
            "organization": {
              "type": "string",
              "minLength": 1
            },
            "visibility": {
              "type": "string",
              "enum": ["private", "public", "internal"],
              "default": "private"
            },
            "branch_protection": {
              "type": "boolean",
              "default": true
            },
            "topics": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "infrastructure": {
          "type": "object",
          "required": ["namespace", "environments"],
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
            },
            "environments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": ["dev", "staging", "prod"]
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"],
              "additionalProperties": false,
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"],
              "additionalProperties": false,
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            }
          }
        },
        "scaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_replicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 1
            },
            "max_replicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 5
            },
            "target_cpu_utilization": {
              "type": "integer",
              "minimum": 10,
              "maximum": 95,
              "default": 70
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "bucket_name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
            }
          }
        },
        "messaging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "stream_name": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "subjects": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "vault_path": {
              "type": "string",
              "pattern": "^secret/[a-z][a-z0-9-/]*$"
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "host": {
              "type": "string"
            },
            "tls": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    }
  }
}
